{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/harmony-agent-tools/scenario.schema.json",
  "title": "Harmony Device Scenario",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "string"
    },
    "outputDirectory": {
      "type": "string",
      "default": "artifacts"
    },
    "displayWidth": {
      "type": "integer",
      "minimum": 1
    },
    "displayHeight": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/display"
          },
          {
            "$ref": "#/$defs/fold"
          },
          {
            "$ref": "#/$defs/rotate"
          },
          {
            "$ref": "#/$defs/waitDisplay"
          },
          {
            "$ref": "#/$defs/tap"
          },
          {
            "$ref": "#/$defs/swipe"
          },
          {
            "$ref": "#/$defs/wait"
          },
          {
            "$ref": "#/$defs/screenshot"
          },
          {
            "$ref": "#/$defs/gestureCapture"
          }
        ]
      }
    }
  },
  "required": [
    "steps"
  ],
  "$defs": {
    "timedStep": {
      "type": "object",
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "display"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "action"
      ]
    },
    "fold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "fold"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": ["folded", "half", "expanded", "dual-expanded"]
        }
      },
      "required": [
        "action",
        "state"
      ]
    },
    "rotate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "rotate"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "rotation": {
          "enum": [0, 90, 180, 270]
        }
      },
      "required": [
        "action",
        "rotation"
      ]
    },
    "waitDisplay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "waitDisplay"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 10000,
          "default": 5000
        }
      },
      "required": [
        "action"
      ]
    },
    "tap": {
      "allOf": [
        {
          "$ref": "#/$defs/timedStep"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "tap"
            },
            "atMs": {
              "type": "integer",
              "minimum": 0
            },
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "xRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "yRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pressMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 450,
              "default": 100
            }
          },
          "required": [
            "action"
          ],
          "oneOf": [
            {
              "required": ["x", "y"]
            },
            {
              "required": ["xRatio", "yRatio"]
            }
          ]
        }
      ]
    },
    "swipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "swipe"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "startX": {
          "type": "integer"
        },
        "startY": {
          "type": "integer"
        },
        "endX": {
          "type": "integer"
        },
        "endY": {
          "type": "integer"
        },
        "startXRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "startYRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "endXRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "endYRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000,
          "default": 300
        },
        "keepMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 0
        }
      },
      "required": [
        "action"
      ],
      "oneOf": [
        {
          "required": ["startX", "startY", "endX", "endY"]
        },
        {
          "required": ["startXRatio", "startYRatio", "endXRatio", "endYRatio"]
        }
      ]
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "wait"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "action",
        "milliseconds"
      ]
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "screenshot"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    },
    "gestureCapture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "gestureCapture"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "startX": {
          "type": "integer"
        },
        "startY": {
          "type": "integer"
        },
        "endX": {
          "type": "integer"
        },
        "endY": {
          "type": "integer"
        },
        "startXRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "startYRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "endXRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "endYRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000,
          "default": 300
        },
        "keepMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 0
        },
        "captureAtMs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "captureAtMs"
      ],
      "oneOf": [
        {
          "required": ["startX", "startY", "endX", "endY"]
        },
        {
          "required": ["startXRatio", "startYRatio", "endXRatio", "endYRatio"]
        }
      ]
    }
  }
}
